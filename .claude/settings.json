{
  "permissions": {
    "allow": [
      "Bash(git pull --ff-only origin main)",
      "Bash(python3 scripts/setup_check.py *)",
      "Bash(python3 scripts/piyolog_summary.py *)",
      "Bash(python3 scripts/codmon_fill.py *)",
      "Bash(python3 scripts/codmon_browser.py *)",
      "Edit(/tmp/**)",
      "Bash(rm tmp/draft.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import playwright' 2>/dev/null || python3 -m pip install -q playwright >/dev/null 2>&1 || true; [ \"$CLAUDE_CODE_REMOTE\" = true ] && python3 \"$CLAUDE_PROJECT_DIR/scripts/codmon_browser.py\" start && python3 \"$CLAUDE_PROJECT_DIR/scripts/codmon_browser.py\" prefetch || true",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/setup_check.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/block_repo_changes.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
