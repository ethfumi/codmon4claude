{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import playwright' 2>/dev/null || python3 -m pip install -q playwright >/dev/null 2>&1 || true",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/setup_check.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
